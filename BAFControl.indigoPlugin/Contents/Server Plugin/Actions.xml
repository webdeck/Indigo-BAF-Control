<?xml version="1.0" encoding="UTF-8"?>
<Actions>
    <!-- FAN MOTOR ACTIONS (Parent) -->
    
    <!-- Fan Auto Mode -->
    <Action id="enableFanAuto" deviceTypeId="bafFan">
        <Name>Enable Fan Auto Mode</Name>
        <CallbackMethod>actionEnableFanAuto</CallbackMethod>
    </Action>

    <!-- Whoosh Mode -->
    <Action id="enableWhoosh" deviceTypeId="bafFan">
        <Name>Enable Whoosh Mode</Name>
        <CallbackMethod>actionEnableWhoosh</CallbackMethod>
    </Action>
    <Action id="disableWhoosh" deviceTypeId="bafFan">
        <Name>Disable Whoosh Mode</Name>
        <CallbackMethod>actionDisableWhoosh</CallbackMethod>
    </Action>

    <!-- Eco Mode -->
    <Action id="enableEco" deviceTypeId="bafFan">
        <Name>Enable Eco Mode</Name>
        <CallbackMethod>actionEnableEco</CallbackMethod>
    </Action>
    <Action id="disableEco" deviceTypeId="bafFan">
        <Name>Disable Eco Mode</Name>
        <CallbackMethod>actionDisableEco</CallbackMethod>
    </Action>

    <!-- Reverse Direction -->
    <Action id="enableReverse" deviceTypeId="bafFan">
        <Name>Enable Reverse Direction</Name>
        <CallbackMethod>actionEnableReverse</CallbackMethod>
    </Action>
    <Action id="disableReverse" deviceTypeId="bafFan">
        <Name>Disable Reverse Direction</Name>
        <CallbackMethod>actionDisableReverse</CallbackMethod>
    </Action>


    <!-- FAN LIGHT ACTIONS (Managed Child) -->
    
    <!-- Light Auto Mode -->
    <Action id="enableLightAuto" deviceTypeId="bafLight">
        <Name>Enable Light Auto Mode</Name>
        <CallbackMethod>actionEnableLightAuto</CallbackMethod>
    </Action>

    <!-- Light Color Temperature (Kelvin) -->
    <Action id="controlColorTemperature" deviceTypeId="bafLight">
        <Name>Set Color Temperature</Name>
        <CallbackMethod>actionControlColorTemperature</CallbackMethod>
    </Action>
</Actions>

<?xml version="1.0" encoding="UTF-8"?>
<Devices>
    <Device id="bafBridge">
        <Name>Big Ass Fan</Name>
        <ConfigUI>
            <UIGroup id="networkGroup">
                <Title>Network Connection</Title>
                <Field id="discovery_label" type="label">
                    <Label>Select an automatically discovered fan from the list, or choose "Manual Input" below.</Label>
                </Field>
                <Field id="selected_address_source" type="menu" sort="true" dynamicReload="true">
                    <Label>Select Fan or Input Method:</Label>
                    <List class="Plugin" method="getDiscoveredDevices" />
                </Field>

                <!-- Manual Input Field (only visible when "Manual Input" is selected above) -->
                <Field id="manual_address" type="textfield">
                    <Label>Manual Address:</Label>
                    <Hint>Enter the IP address (e.g., 192.168.1.100) or Hostname (e.g., myfan.local).</Hint>
                    <VisibilityBindings>
                        <Binding type="EnableVisibility" uiId="selected_address_source" value="manual" />
                    </VisibilityBindings>
                </Field>
            </Field>
        </ConfigUI>
        <States>
            <!-- Hidden state updated by plugin.py once hardware is connected -->
            <State id="has_light_hardware"><ValueType>Boolean</ValueType></State>
        </States>
    </Device>

    <!-- Fan Motor Device (Child) -->
    <Device id="bafFan" type="speedcontrol" icon="fan">
        <Name>Big Ass Fan (Motor)</Name>
        <ConfigUI>
            <Field id="bridge_id" type="menu">
                <Label>Select Fan Bridge:</Label>
                <List class="indigo.devices" filter="bafBridge" />
            </Field>
        </ConfigUI>
        <States>
            <State id="auto_mode" icon="auto_mode_motor"><ValueType>Boolean</ValueType></State>
            <State id="whoosh_mode" icon="whoosh_mode"><ValueType>Boolean</ValueType></State>
            <State id="reverse" icon="reverse_mode"><ValueType>Boolean</ValueType></State>
            <State id="eco_mode" icon="eco_mode"><ValueType>Boolean</ValueType></State>
        </States>
    </Device>

    <!-- Fan Light Device (Child) -->
    <Device id="bafLight" type="dimmer" icon="light">
        <Name>Big Ass Fan (Light)</Name>
        <!-- Automatically hide/show based on the hardware discovery state -->
        <ConfigUI visibleBindingId="bafBridge" visibleBindingProperty="has_light_hardware">
            <Field id="bridge_id" type="menu">
                <Label>Select Fan Bridge:</Label>
                <List class="indigo.devices" filter="bafBridge" />
            </Field>
        </ConfigUI>
        <States>
            <State id="auto_mode" icon="auto_mode_light"><ValueType>Boolean</ValueType></State>
            <State id="warmth"><ValueType>Integer</ValueType></State>
        </States>
    </Device>
</Devices>
